# GEMINI_API_KEY: Required if Gemini AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Engine: "sqlite" (zero-config embedded mode) or "mysql" (MySQL 8.0+)
DB_CLIENT="sqlite"

# MySQL 8.0+ Connection (used when DB_CLIENT=mysql)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=crispr_tracker

# Third-Party Genomic Data Service (NCBI Entrez E-utilities API key)
NCBI_API_KEY=

# Optional administrator claim passcode for first-run lab bootstrap
ADMIN_CLAIM_PASSCODE=
